KC_HOSTNAME=localhost
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=auth-db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_HOST_PORT=5438
KEYCLOAK_DB_NAME=postgres
KEYCLOAK_DB_URL=jdbc:postgresql://auth-db:5432/postgres
KEYCLOAK_HTTP_HOST_PORT=8080
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_URL=http://keycloak:8080/auth/
KEYCLOAK_REALM=ROLAP
KEYCLOAK_CLIENT_ID=rolap-web
KEYCLOAK_CLIENT_SECRET=

# Accounts imported into the local ROLAP realm
JOHN_PASSWORD=CHANGE_ME_JOHN_PASSWORD
OPERATOR_PASSWORD=CHANGE_ME_OPERATOR_PASSWORD
WORKER_KEYCLOAK_USERNAME=celery_worker
WORKER_KEYCLOAK_PASSWORD=CHANGE_ME_WORKER_PASSWORD

# REST API database and Django
REST_API_DB_ADMIN_USER=postgres
REST_API_DB_ADMIN_PASSWORD=CHANGE_ME_REST_API_DB_ADMIN_PASSWORD
REST_API_DB_HOST=rest-api-db
REST_API_DB_PORT=5432
REST_API_DB_USER=rolap
REST_API_DB_PASSWORD=CHANGE_ME_REST_API_DB_PASSWORD
